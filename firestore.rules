rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Users and Profiles (synced across all devices & browsers)
    match /users/{userId} {
      allow read: if true;
      allow write: if isValidId(userId);
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if true;
      allow write: if isValidId(adminId);
    }

    // Students master collection
    match /students/{studentId} {
      allow read: if true;
      allow write: if isValidId(studentId);
    }

    // Teachers master collection
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if isValidId(teacherId);
    }

    // Classes collection
    match /classes/{classId} {
      allow read: if true;
      allow write: if isValidId(classId);
    }

    // Majors (Jurusan) collection
    match /majors/{majorId} {
      allow read: if true;
      allow write: if isValidId(majorId);
    }

    // Subjects (Mata Pelajaran) collection
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isValidId(subjectId);
    }

    // Academic Years collection
    match /academicYears/{yearId} {
      allow read: if true;
      allow write: if isValidId(yearId);
    }

    // Attendance sessions
    match /attendanceSessions/{sessionId} {
      allow read: if true;
      allow write: if isValidId(sessionId);
    }

    // Attendance records
    match /attendanceRecords/{recordId} {
      allow read: if true;
      allow write: if isValidId(recordId);
    }

    // Attendance corrections
    match /attendanceCorrections/{correctionId} {
      allow read: if true;
      allow write: if isValidId(correctionId);
    }

    // Assessments
    match /assessments/{assessmentId} {
      allow read: if true;
      allow write: if isValidId(assessmentId);
    }

    // Assessment scores
    match /assessmentScores/{scoreId} {
      allow read: if true;
      allow write: if isValidId(scoreId);
    }

    // Audit logs (Immutable)
    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId);
      allow update, delete: if false;
    }

    // Chat messages (Real-time student chat room & admin monitoring)
    match /chatMessages/{messageId} {
      allow read: if true;
      allow write: if isValidId(messageId);
    }

    // Direct Messages (1-on-1 DM between profiles across all devices)
    match /directMessages/{messageId} {
      allow read: if true;
      allow write: if isValidId(messageId);
    }

    // Custom Report Templates / Customizer Settings (PDF Kop, Logo, TTD)
    match /reportTemplates/{templateId} {
      allow read: if true;
      allow write: if isValidId(templateId);
    }

    // Notifications (Targeted & Broadcast)
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isValidId(notificationId);
    }

    // System & Visual Settings (Login & Header Banner backgrounds)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // PKL Administration (Industry Partners, Visits, and Student Reports)
    match /pklPartners/{partnerId} {
      allow read: if true;
      allow write: if isValidId(partnerId);
    }

    match /pklVisits/{visitId} {
      allow read: if true;
      allow write: if isValidId(visitId);
    }

    match /pklReports/{reportId} {
      allow read: if true;
      allow write: if isValidId(reportId);
    }

    match /pklTracerStudies/{tracerId} {
      allow read: if true;
      allow write: if isValidId(tracerId);
    }

    // Lesson Schedules (Jadwal Pelajaran di Data Pokok)
    match /lessonSchedules/{scheduleId} {
      allow read: if true;
      allow write: if isValidId(scheduleId);
    }

    // Gallery Photos (Activity documentation managed by Admin, shown in Login Gallery)
    function isValidGalleryPhoto(data) {
      return data.keys().hasAll(['id', 'title', 'category', 'activityDate', 'imageUrl', 'isPublished', 'order', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'title', 'caption', 'category', 'activityDate', 'location', 'imageUrl', 'aspectRatioOverride', 'imageFitOverride', 'isFeatured', 'isPublished', 'order', 'uploadedBy', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 160 &&
        (!('caption' in data) || (data.caption is string && data.caption.size() <= 600)) &&
        data.category in ['Kegiatan Sekolah', 'PKL & Industri', 'Prestasi & Lomba', 'Ekstrakurikuler', 'Akademik'] &&
        data.activityDate is string && data.activityDate.size() > 0 && data.activityDate.size() <= 30 &&
        (!('location' in data) || (data.location is string && data.location.size() <= 140)) &&
        data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 850000 &&
        (!('aspectRatioOverride' in data) || data.aspectRatioOverride in ['inherit', '16:9', '4:3', '1:1', '21:9']) &&
        (!('imageFitOverride' in data) || data.imageFitOverride in ['inherit', 'cover', 'contain']) &&
        (!('isFeatured' in data) || data.isFeatured is bool) &&
        data.isPublished is bool &&
        data.order is number &&
        (!('uploadedBy' in data) || (data.uploadedBy is string && data.uploadedBy.size() <= 120)) &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    match /galleryPhotos/{photoId} {
      allow read: if true;
      allow create, update: if isValidId(photoId) && isValidGalleryPhoto(request.resource.data);
      allow delete: if isValidId(photoId);
    }

    // Connection test document
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
